{
  "compilerOptions": {
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src"]
}
